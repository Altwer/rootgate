# rootgate settings. Copy to rootgate.env (ignored by git) and fill in.
# Read by install.sh and by the Android build; nothing else needs editing.

# This computer's Tailscale IPv4 (run: tailscale ip -4).
# install.sh detects it when empty; the app uses it as its default address.
COMPUTER_IP=

# The phone's Tailscale IPv4 (Tailscale app, or: tailscale status).
# Only this address may connect as the approver.
PHONE_IP=

# The phone's approval public key: shown in the rootgate app.
PHONE_PUBKEY=

# Which user may run ask-root (run: id -u). Default: the user running sudo.
ALLOWED_UID=
